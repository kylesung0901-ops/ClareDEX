# ClareDEX v2 환경변수 예시 — 실제 키는 .env 에만 두세요 (git 커밋 금지)
# 금융감독원 OpenDART 무료 인증키: https://opendart.fss.or.kr
OPENDART_API_KEY=
# 한국은행 ECOS 무료 인증키: https://ecos.bok.or.kr
ECOS_API_KEY=
# 블로그 본문 이미지에 들어갈 공개 도메인 (기본값 https://www.claredex.com)
CLAREDEX_PUBLIC_BASE_URL=https://www.claredex.com
# 운영자(/admin) 로그인 비밀번호 — 배포 시에는 반드시 길고 무작위인 값으로 바꾸세요.
# 값이 없으면 개발용 기본값(claredex-admin-2026)으로 동작하며 기동 시 경고가 남습니다.
ADMIN_PASSWORD=claredex-admin-2026
